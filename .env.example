APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./platform.db
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=train-platform
MINIO_SECRET_KEY=change-this-minio-password
MINIO_SECURE=false
MLFLOW_TRACKING_URI=http://localhost:5000
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=5368709120
EXECUTOR_BACKEND=fake
FAKE_RUN_DURATION_SECONDS=12
SCHEDULER_POLL_SECONDS=0.5
DOCKER_BINARY=docker
DOCKER_NETWORK=bridge
DOCKER_USER=1000:1000
DOCKER_CPU_LIMIT=4
DOCKER_MEMORY_LIMIT_GB=16
DOCKER_SHM_SIZE_GB=4
DOCKER_PIDS_LIMIT=1024
NVIDIA_SMI_BINARY=nvidia-smi
MAX_COLLECTED_ARTIFACTS=200
MAX_COLLECTED_ARTIFACT_BYTES=21474836480
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Platform Admin
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
